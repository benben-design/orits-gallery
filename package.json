{
  "name": "orit-bar-shai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-image-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && node scripts/check-contrast.mjs && node scripts/check-admin-guard.mjs && node scripts/check-sitemap.mjs && node scripts/check-image-crop.mjs && node scripts/check-page-headings.mjs && node scripts/check-locale-strings.mjs",
    "images:manifest": "node scripts/generate-image-manifest.mjs",
    "dev:placeholders": "node scripts/generate-dev-placeholders.mjs",
    "seed:local": "node --env-file-if-exists=.env.local scripts/seed-local-database.mjs",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin-user.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:guard": "node scripts/check-admin-guard.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:crop": "node scripts/check-image-crop.mjs",
    "check:headings": "node scripts/check-page-headings.mjs",
    "check:strings": "node scripts/check-locale-strings.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3"
  }
