# Environment variables.
#
# Copy this file to .env.local and put real values in that copy:
#
#     cp .env.example .env.local
#
# .env.local is git-ignored (see the .env*.local rule in .gitignore). THIS file
# is committed, so every value below is a dummy and never a real credential.
#
# A missing variable must fail loudly rather than degrade silently, so add a key
# here in the same change that starts reading it — this file is the list of what
# the project needs, and it is only useful if it is complete.

# ---------------------------------------------------------------------------
# Database — required, the only one wired up today
# ---------------------------------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# The local database is art_studio. The role and password below are dummies —
# replace them in .env.local with whichever role you created in pgAdmin.
#
# Neon later appends ?sslmode=require; node-postgres reads sslmode out of the
# connection string itself, so moving between local and Neon is a change to
# this value and to nothing in the code.
DATABASE_URL=postgresql://orit_app:change-me@localhost:5432/art_studio

# ---------------------------------------------------------------------------
# Admin session — not built yet
# ---------------------------------------------------------------------------
# Signs the artist's httpOnly session cookie. A long random string, generated
# per environment. Never shared between local and production.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# ---------------------------------------------------------------------------
# Site URL — not read yet
# ---------------------------------------------------------------------------
# Absolute base for canonical URLs, hreflang pairs, the sitemap and OG images.
# Those are absolute by definition, so they cannot be built from a relative path.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cloudinary — not wired up yet
# ---------------------------------------------------------------------------
# Images are served out of public/paintings today and move to Cloudinary behind
# the same components later.
CLOUDINARY_CLOUD_NAME=example-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=example-api-secret

# ---------------------------------------------------------------------------
# Payments — provider not chosen yet
# ---------------------------------------------------------------------------
# Stripe versus an Israeli provider that issues a tax invoice is still open, so
# these names are generic and will change with that decision.
#
# The webhook secret is what proves a payment callback genuinely came from the
# provider. Payment state is written by that verified webhook and by nothing
# else — never by a client redirect.
PAYMENT_PROVIDER_SECRET_KEY=example-secret-key
PAYMENT_PROVIDER_WEBHOOK_SECRET=example-webhook-secret
